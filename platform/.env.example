# Postgres ulanish manzili (Vercel + Neon integratsiyasi avtomatik qo'yadi)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Qurilma maxfiy kalitlarini shifrlash uchun 32 baytli kalit (base64). Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Birinchi administratorni yaratish uchun bir martalik kod (foydalanuvchi yo'q paytdagina ishlaydi)
SETUP_TOKEN=

# Ixtiyoriy: Telegram bot tokeni (@BotFather dan)
TELEGRAM_BOT_TOKEN=
